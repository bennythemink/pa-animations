---
import '@styles/global.css'
import { Font } from 'astro:assets'
import Footer from '@components/Footer.astro'
import Menu from '@components/Menu.astro'
import { COLOR_KEYS, COLORS_RGB } from '@scripts/flow-field.ts'

interface Props {
  title?: string
  description?: string
  /** Skip the menu spacer for pages with full-height heroes */
  noMenuSpacer?: boolean
  /** Override the random logo colour pair. Pass { p: '#hex', a: '#hex' }. */
  logoColors?: { p: string; a: string }
  published?: boolean
  /** When published is false, follow links on the page anyway (noindex, follow instead of noindex, nofollow). */
  follow?: boolean
}

const {
  title = 'Pixel Agency',
  description = 'Melbourne digital agency specialising in web design, app development, and AI. Working with businesses across Australia. You talk to the people doing the work.',
  noMenuSpacer = false,
  logoColors,
  published = true,
  follow = false
} = Astro.props

const pageTitle = title === 'Pixel Agency' ? title : `${title} | Pixel Agency`

// This dynamically outputs: https://www.pixelagency.com.au/your-page-path
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-image.png', Astro.site)
---

<!doctype html>
<html lang="en-AU" class="h-full m-0">
  <head>
    <meta charset="UTF-8" />
    {!published && <meta name="robots" content={`noindex, ${follow ? 'follow' : 'nofollow'}`} />}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />

    <meta name="apple-mobile-web-app-title" content="Pixel Agency" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Open Graph (LinkedIn, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pixel Agency" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />

    <Font cssVariable="--font-ibm-plex-sans" />
    <Font cssVariable="--font-lateef" />
    <title>{pageTitle}</title>
    {
      /* Pick a random flow-field accent colour on every page load.
        Keys sourced from flow-field.ts at build time via define:vars.
        Inline so it runs synchronously before any deferred scripts. */
    }
    <script define:vars={{ colorKeys: COLOR_KEYS, colorsRGB: COLORS_RGB }} is:inline>
      var key = colorKeys[Math.floor(Math.random() * colorKeys.length)]
      document.documentElement.dataset.accentColor = key
      document.documentElement.style.setProperty('--accent-bgc', colorsRGB[key])
    </script>

    {/* Structured data for SEO */}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "@id": "https://www.pixelagency.com.au/#organisation",
        "name": "Pixel Agency",
        "description": "Melbourne digital agency specialising in web, app, & brand design, development, consulting, and AI solutions. Working with businesses across Australia.",
        "url": "https://www.pixelagency.com.au",
        "logo": "https://www.pixelagency.com.au/pa.png",
        "telephone": "03 9943 2429",
        "email": "hello@pixelagency.com.au",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "1 Collins Street",
          "addressLocality": "Melbourne",
          "addressRegion": "VIC",
          "postalCode": "3000",
          "addressCountry": "AU"
        },
        "sameAs": ["https://www.linkedin.com/company/pixel-agency-au/"],
        "areaServed": "Australia"
      }
    </script>

    <!-- Google Tag Manager (Partytown Version) -->
    <script type="text/partytown">
      ;(function (w, d, s, l, i) {
        w[l] = w[l] || []
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : ''
        j.async = true
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl
        f.parentNode.insertBefore(j, f)
      })(window, document, 'script', 'dataLayer', 'GTM-TSXFMXLV')
    </script>
    <!-- End Google Tag Manager -->

    <slot name="head" />

    <script>
      ;(function (c, h, k, o, u, t) {
        c[u] = c[u] || {
          q: [],
          push: function (a) {
            this.q.push(a)
          }
        }
        if (c[u].__s || h.querySelector('script[data-chkout-tag]')) return
        c[u].__s = 1
        c[u].channel = t
        function pt() {
          var meta = h.querySelector('meta[name="chkout:page-type"]')
          if (meta) {
            var c = meta.getAttribute('content')
            if (c && /^[pclmao]$/.test(c)) return c
          }
          var p = h.location.pathname
          if (/\/products?\//i.test(p)) return 'p'
          if (/\/(collections?|categor(?:y|ies))\//i.test(p)) return 'c'
          if (/\/(blog|articles?|news)\//i.test(p)) return 'a'
          if (/\/listings?\//i.test(p)) return 'l'
          return 'o'
        }
        function rd(n) {
          try {
            var m = h.cookie.match(new RegExp('(?:^|; ?)' + n + '=([^;]*)'))
            return m ? m[1] : ''
          } catch (e) {
            return ''
          }
        }
        var V = rd('chkvid'),
          I = rd('chksid'),
          P = rd('chkpid')
        var s = h.createElement(o)
        s.async = 1
        s.setAttribute('data-chkout-tag', '1')
        s.src =
          k +
          '/c/' +
          t +
          '/tag.js?t=' +
          pt() +
          '&u=' +
          encodeURIComponent(h.location.pathname + h.location.search) +
          (V ? '&v=' + V : '') +
          (I ? '&i=' + I : '') +
          (P ? '&p=' + P : '')
        s.crossOrigin = 'anonymous'
        ;(h.head || h.getElementsByTagName(o)[0].parentNode).appendChild(s)
      })(window, document, 'https://cdn-dev.chkout.dev', 'script', 'chkout', '019f1bb0-0289-7d64-a72f-6afa5bbfe43c')
    </script>

    <script src="https://analytics.ahrefs.com/analytics.js" data-key="tvT0yrnLQJvdmExXFO/xnw" async></script>
  </head>
  <body class="m-0 min-h-screen bg-pixel-lte-platinum">
    <Menu logoColors={logoColors} />
    {!noMenuSpacer && <div class="h-[70px] lg:h-[128px]" aria-hidden="true" />}
    <slot />
    <Footer />
  </body>
</html>
