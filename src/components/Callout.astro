---
import Grid from '@components/Grid.astro'
import BookACallButton from '@components/BookACallButton.astro'
import CalEmbed from '@components/CalEmbed.astro'

interface Props {
  calloutText?: string
  ctaText?: string
  url?: string
}
const {
  calloutText = "If you're exploring a digital project or want an honest second opinion, we're always happy to talk it through.",
  ctaText = "Let's find a path forward →",
  url = '/contact'
} = Astro.props
---

<section id="callout" class="lg:mt-20">
  <Grid>
    <div
      class="col-span-full px-5 lg:px-0 py-10 lg:py-14 grid grid-cols-12 gap-5"
      style="background-color: var(--accent-bgc);"
    >
      <div class="col-span-12 lg:col-start-2 lg:col-span-7">
        <h4 class="text-[24px] lg:text-[40px] leading-[1.15] tracking-[-0.02em]">
          {calloutText}
        </h4>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={url} class="font-sans font-normal inline-block w-fit bg-white px-4 py-2 text-base hover:underline"
            >{ctaText}</a
          >
          <span class="font-sans font-normal text-base">or</span>
          <BookACallButton class="font-sans font-normal text-base underline underline-offset-2 cursor-pointer" />
        </div>
      </div>
    </div>
  </Grid>
</section>

<CalEmbed />
