---
import Grid from '@components/Grid.astro'
import BookACallButton from '@components/BookACallButton.astro'
import CalEmbed from '@components/CalEmbed.astro'

type LetsTalkButton = 'message' | 'bookACall'

interface LetsTalkConfig {
  buttons?: LetsTalkButton | 'both'
  primaryCta?: LetsTalkButton
}

interface Props {
  config?: LetsTalkConfig
}

const { config = {} } = Astro.props
const { buttons = 'message', primaryCta = 'message' } = config

const showMessage = buttons !== 'bookACall'
const showBookACall = buttons !== 'message'

const order: LetsTalkButton[] = primaryCta === 'bookACall' ? ['bookACall', 'message'] : ['message', 'bookACall']
const activeButtons = order.filter((button) => (button === 'message' ? showMessage : showBookACall))

const primaryClasses = 'font-sans font-normal inline-block w-fit bg-white px-4 py-2 text-base hover:underline'
const secondaryClasses = 'font-sans font-normal text-base underline underline-offset-2 cursor-pointer'
---

<section id="lets-talk">
  <Grid>
    <div
      class="col-span-full grid grid-cols-12 gap-5 pt-7.5 lg:pt-20 lg:pb-36 my-2 lg:my-6"
      style="background-color: var(--accent-bgc);"
    >
      <div class="col-start-2 lg:col-start-2 col-span-10 lg:col-span-5 mb-4 lg:mb-0">
        <h2 class="text-xl lg:text-[80px] leading-[1.04] tracking-[-0.04em]">
          Let&rsquo;s talk about what you&rsquo;re trying to&nbsp;achieve.
        </h2>
      </div>
      <div
        class="col-start-2 lg:col-start-8 col-span-10 lg:col-span-4 flex flex-col justify-start text-[18px] lg:text-2xl leading-[0.76] tracking-[-0.04em] mb-7.5 lg:mb-0"
      >
        <p class="">Whether you've got a detailed brief or just a rough idea, we're happy to have a conversation.</p>
        <p class="mt-4">
          No pitch, no pressure, just a straight talk about what you're working on and whether we're the right&nbsp;fit.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          {
            activeButtons.map((button, index) => (
              <>
                {index > 0 && <span class="font-sans font-normal text-base">or</span>}
                {button === 'message' ? (
                  <a href="/contact" class={index === 0 ? primaryClasses : secondaryClasses}>
                    Message us →
                  </a>
                ) : (
                  <BookACallButton class={index === 0 ? primaryClasses : secondaryClasses} />
                )}
              </>
            ))
          }
        </div>
      </div>
    </div>
  </Grid>
</section>

{showBookACall && <CalEmbed />}
