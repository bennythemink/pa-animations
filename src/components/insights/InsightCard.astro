---
interface Props {
  title: string
  summary: string
  dateLabel: string
  href: string
  backgroundColor: string
  tags?: string[]
}

const { title, summary, dateLabel, href, backgroundColor, tags = [] } = Astro.props as Props
---

<div class="insight-card h-full p-4 lg:p-5" style={`background-color: ${backgroundColor};`}>
  <div class="flex h-full flex-col gap-3">
    <h2 class="text-2xl lg:text-3xl leading-[0.95] tracking-[-0.03em]">
      <a
        href={href}
        class="inline hover:underline hover:underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-black/80"
      >
        {title}
      </a>
    </h2>
    <p class="font-sans text-xs tracking-widest uppercase text-black/60">{dateLabel}</p>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {tags.map((tag) => (
            <span class="tag-pill text-[12px] lg:text-base">{tag}</span>
          ))}
        </div>
      )
    }
    <p class="mt-auto font-serif text-lg lg:text-2xl leading-[0.84] text-black/80">{summary}</p>
  </div>
</div>

<style>
  .tag-pill {
    color: var(--color-black);
    background-color: color-mix(in oklab, var(--color-black) 12%, transparent);
    padding-block: calc(var(--spacing) * 1);
    padding-inline: calc(var(--spacing) * 2);
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 400;
  }
</style>
