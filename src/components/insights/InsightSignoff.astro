---
import BookACallButton from '@components/BookACallButton.astro'
import { siteConfig } from '@config/site'
---

<p>
  Still have questions? Give us a <a href={`tel:${siteConfig.phone}`} class="underline underline-offset-2">call</a>,
  <BookACallButton
    text="book a quick meeting"
    class="font-sans font-normal text-base underline underline-offset-2 cursor-pointer"
  />, or
  <a href="/contact" class="underline underline-offset-2">send us a message</a> to understand more without any pushy sales
  tactics.
</p>
