---

<Layout
  noMenuSpacer
  title="Digital Agency Sydney | Web + App Design, Development, AI, & Consulting"
  description="We are a digital agency working with Sydney businesses on web design, brand design, app development, AI, and consulting. Melbourne-based, Australian-owned, no sales layer. An agency that cares."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Service',
            name: 'Digital Agency Services — Sydney',
            description:
              'Digital agency working with Sydney businesses on web, app & brand design, web & app development, AI solutions, and digital consulting. Melbourne-based, Australian-owned, no sales layer.',
            url: 'https://www.pixelagency.com.au/sydney',
            provider: { '@id': 'https://www.pixelagency.com.au/#organisation' },
            areaServed: {
              '@type': 'City',
              name: 'Sydney',
              containedInPlace: {
                '@type': 'State',
                name: 'New South Wales',
                containedInPlace: { '@type': 'Country', name: 'Australia' }
              }
            },
            serviceType: 'Web Design, App Development, AI, Digital Consulting'
          },
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.pixelagency.com.au' },
              { '@type': 'ListItem', position: 2, name: 'Sydney', item: 'https://www.pixelagency.com.au/sydney' }
            ]
          }
        ]
      })}
    />
  </Fragment>

  <div id="site-content">
    <section id="hero-puzzle-section" class="relative h-screen flex items-center justify-center">
      <div id="hero-puzzle-content" class="text-center">
        <h2
          id="hero-tagline-top"
          class="text-2xl sm:text-4xl lg:text-5xl mb-6 sm:mb-8 font-sans font-normal tracking-[-0.03em] opacity-0"
        >
          We are
        </h2>
        <div id="hero-puzzle" class="relative mx-auto"></div>
        <p
          id="hero-tagline-bottom"
          class="text-2xl sm:text-4xl lg:text-5xl mt-6 sm:mt-8 font-sans font-normal tracking-[-0.03em] leading-[1.2] opacity-0"
        >
          a <span class="text-pixel-celestial underline underline-offset-4">refreshing</span> Sydney digital partner
        </p>

        <div id="hero-cta" class="mt-4 lg:mt-8 opacity-0">
          <CTA label="Let's talk" url="/contact" />
        </div>
      </div>
    </section>

    <OurApproachSection label="Have a digital problem?" labelColour="pixel-fire">
