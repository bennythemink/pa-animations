---
import Layout from '@layouts/Layout.astro'
import Grid from '@components/Grid.astro'
import BookACallButton from '@components/BookACallButton.astro'
import FeatureCards from '@components/services/FeatureCards.astro'
import BlurbPoints from '@components/services/BlurbPoints.astro'
import ContactForm from '@components/ContactForm.astro'
import { SitePage } from '@data/analyticsCaller'
import Callout from '@components/Callout.astro'

/**
 * "What happens next?" FeatureCards variables
 */
const nextSteps = [
  { title: '1. Free call', description: "We listen to what's actually happened, no obligation." },
  { title: '2. Review', description: 'We check what you currently have access to and what state things are in.' },
  { title: '3. Clear written plan', description: 'A straightforward summary of options and cost.' },
  {
    title: '4. Deliver',
    description: 'We implement the agreed plan and ensure your site is secure and running smoothly.'
  }
]

/**
 * "5 things to know?" FeatureCards variables
 */
const fiveThingsToKnow = [
  {
    title: '1. Domain',
    description: 'Do you own your domain name outright, registered to your business, not your agency?'
  },
  { title: '2. Hosting', description: 'Do you have direct login access to your hosting account?' },
  { title: '3. CMS', description: "Do you have admin access to your website's CMS?" },
  {
    title: '4. Code',
    description: "Do you have access to your website's source code, or a current backup of it?"
  },
  {
    title: '5. Email',
    description:
      'Is your business email independent of your website hosting, so it keeps working even if your site goes down?'
  }
]

/**
 * FAQs
 */
const faqs = [
  {
    q: 'Will this cost more than my old agency?',
    a: "Not necessarily. We'll give you an honest cost estimate upfront, no obligation to proceed."
  },
  {
    q: 'What happens to my domain and hosting?',
    a: 'That depends on what you currently have access to, working that out together is part of the free review.'
  },
  {
    q: 'How fast can you actually move?',
    a: 'For urgent situations we can usually start within days. For a considered switch, at your pace.'
  },
  {
    q: 'Do I need to sign a long contract?',
    a: 'No lock-in contracts.'
  },
  {
    q: "My current agency is still around, they're just not delivering, can you still help?",
    a: 'Yes. Plenty of people we talk to are in exactly this position, nothing needs to have gone wrong for it to be worth a second opinion.'
  }
]
---

<Layout
  title="Agency Gone Quiet or Not Delivering?"
  description="Has your digital agency gone quiet or not delivering? Get a clear, honest plan within 48 hours. No lock-in contracts, Australian-owned team that gets it done."
>
  <section id="hero" class="pt-10 pb-12 lg:pt-16 lg:pb-20">
    <Grid>
      <div class="col-span-full lg:col-start-2 lg:col-span-5">
        <h1 class="text-6xl lg:text-[80px] p-0 leading-[1.04] tracking-[-0.04em]">
          Agency Gone Quiet or Not Delivering?
        </h1>
      </div>
      <div class="col-span-full flex flex-col gap-4 mt-4 lg:mt-0 lg:col-start-7 lg:col-span-5">
        <p class="text-lg lg:text-3xl leading-[1.04] lg:mt-2.5">
          Get a clear, honest plan within 48 hours. No lock-in contracts, no jargon, just a straight answer.
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <BookACallButton
            text="Book a call"
            class="ah-accent-cta font-sans font-normal inline-block w-fit bg-white px-4 py-2 text-base transition-colors hover:underline cursor-pointer"
          />
          <span class="font-sans font-normal text-base">or</span>
          <a href="#contact-form" class="font-sans font-normal text-base underline underline-offset-2 cursor-pointer"
            >Message us →</a
          >
        </div>
      </div>
    </Grid>
  </section>

  <section id="scenario" class="pb-12 lg:pb-20 lg:my-20">
    <Grid>
      <div class="col-span-full lg:col-start-2 mb-6 lg:mb-10">
        <h2 class="section-header text-pixel-drk-poppy text-2xl lg:text-4xl">Which one sounds like you?</h2>
      </div>
      <div class="col-span-full lg:col-start-2 lg:col-span-10 grid grid-cols-1 lg:grid-cols-3 gap-5">
        <article class="bg-pixel-poppy p-8 flex flex-col gap-3 lg:min-h-[400px] lg:justify-between">
          <h3 class="text-xl lg:text-4xl leading-[1.1]">Your agency has gone quiet or shut down?</h3>
          <p>We can get your site secured and back under your control within days, not weeks.</p>
        </article>

        <article class="bg-pixel-solar p-8 flex flex-col gap-3 lg:min-h-[400px] lg:justify-between">
          <h3 class="text-xl lg:text-4xl leading-[1.1]">Your agency is slow to respond or not delivering?</h3>
          <p>You shouldn't have to chase your own website. We'll take it from here.</p>
        </article>

        <article class="bg-pixel-fire p-8 flex flex-col gap-3 lg:min-h-[400px] lg:justify-between">
          <h3 class="text-xl lg:text-4xl leading-[1.1]">You're just not happy with the results or the cost anymore</h3>
          <p>A second opinion costs nothing, and there's no pressure either way.</p>
        </article>
      </div>
    </Grid>
  </section>

  <section id="fix" class="pb-12 lg:pb-20">
    <Grid>
      <div class="col-span-full lg:col-start-2">
        <h2 class="section-header text-pixel-celestial text-2xl lg:text-4xl">How do we fix this?</h2>
      </div>

      <div class="col-span-full lg:col-start-2 lg:col-span-4 flex flex-col gap-4">
        <h3 class="text-[40px] lg:text-[80px] leading-[1.04] tracking-[-0.04em]">Through four simple steps.</h3>
      </div>
    </Grid>
  </section>

  <FeatureCards cards={nextSteps} style="left-aligned" margin="pb-6 lg:pb-10" />

  <Callout
    calloutText="Interested already? Let\'s jump to the contact form to open a conversation, or schedule a call."
    ctaText="Message us →"
    url="#contact-form"
  />

  <section id="about-us" class="pb-12 lg:pb-20 lg:mt-20">
    <Grid>
      <div class="col-span-full lg:col-start-2">
        <h2 class="section-header text-pixel-teal text-2xl lg:text-4xl">Why trust us?</h2>
      </div>

      <div class="col-span-full lg:col-start-2 lg:col-span-4 flex flex-col gap-4">
        <h3 class="text-[40px] lg:text-[80px] leading-[1.04] tracking-[-0.04em]">We have been through this before.</h3>
      </div>

      <div class="col-span-full lg:col-start-7 lg:col-span-5 flex flex-col gap-6 mt-6 lg:mt-0">
        <p>
          Pixel Agency was founded by people who helped a previous agency's clients move their sites to safety when that
          agency closed without warning. We know what this feels like from the other side.
        </p>
        <p>
          We've seen agency relationships go wrong in pretty much every way they can go wrong, from an agency vanishing
          overnight with no warning, to a slow decline in quality nobody wants to admit is happening. Either way, the
          fix starts the same: understanding exactly what you have, and what you're missing.
        </p>
      </div>
    </Grid>
  </section>

  <section id="tips" class="pb-12 lg:pb-20 lg:mt-20">
    <Grid>
      <div class="col-span-full lg:col-start-2">
        <h2 class="section-header text-pixel-rosy text-2xl lg:text-4xl">Not ready to talk yet?</h2>
      </div>

      <div class="col-span-full lg:col-start-2 lg:col-span-4 flex flex-col gap-4">
        <h3 class="text-[40px] lg:text-[80px] leading-[1.04] tracking-[-0.04em]">
          Five things you should control right now.
        </h3>
      </div>

      <div class="col-span-full lg:col-start-7 lg:col-span-5 flex flex-col gap-6 mt-6 lg:mt-0">
        <p>
          Whatever happens with your current agency, there are five things every business should control outright.
          Answer honestly, most people are surprised by what they don't actually have. We also have a more in-depth
          article on
          <a
            href="/insights/how-to-protect-your-business-in-case-your-agency-closes"
            class="underline underline-offset-2">how to protect your business in case your agency closes</a
          >.
        </p>
        <p class="mt-4">
          If you answer yes to all five of the below, great, you're in a really strong position. However, if you answer
          no to any of these, it's worth taking a look into. Even if you never talk to us.
        </p>
      </div>
    </Grid>
  </section>

  <FeatureCards cards={fiveThingsToKnow} style="left-aligned" margin="pb-6 lg:pb-10" />

  <section id="faqs" class="pb-12 lg:pb-20 lg:mt-20">
    <Grid>
      <div class="col-span-full lg:col-start-2">
        <h2 class="section-header text-pixel-rosy text-2xl lg:text-4xl">FAQs</h2>
      </div>

      <div class="col-span-full lg:col-start-2 lg:col-span-4 flex flex-col gap-4">
        <h3 class="text-[40px] lg:text-[80px] leading-[1.04] tracking-[-0.04em]">Common questions we get asked.</h3>
      </div>

      <div class="col-span-full lg:col-start-7 lg:col-span-5 flex flex-col gap-6 mt-6 lg:mt-0">
        <ul class="lg:mt-4 flex flex-col gap-4">
          <li class="flex items-start gap-3 ml-2 lg:ml-4 lg:my-1">
            <span class="shrink-0 w-3 h-3 mt-[2.5px] lg:mt-1.25" style={`background-color: var(--accent-bgc);`}></span>
            <span>
              <strong>Will this cost more than my old agency?</strong><br />
              Not necessarily. We'll give you an honest cost estimate upfront, no obligation to proceed.
            </span>
          </li>
          <li class="flex items-start gap-3 ml-2 lg:ml-4 lg:my-1">
            <span class="shrink-0 w-3 h-3 mt-[2.5px] lg:mt-1.25" style={`background-color: var(--accent-bgc);`}></span>
            <span>
              <strong>What happens to my domain and hosting?</strong><br />
              That depends on what you currently have access to, working that out together is part of the free review.
            </span>
          </li>
          <li class="flex items-start gap-3 ml-2 lg:ml-4 lg:my-1">
            <span class="shrink-0 w-3 h-3 mt-[2.5px] lg:mt-1.25" style={`background-color: var(--accent-bgc);`}></span>
            <span>
              <strong>How fast can you actually move?</strong><br />
              For urgent situations we can usually start within days. For a considered switch, at your pace.
            </span>
          </li>
          <li class="flex items-start gap-3 ml-2 lg:ml-4 lg:my-1">
            <span class="shrink-0 w-3 h-3 mt-[2.5px] lg:mt-1.25" style={`background-color: var(--accent-bgc);`}></span>
            <span>
              <strong>Do I need to sign a long contract?</strong><br />
              No lock-in contracts.
            </span>
          </li>
          <li class="flex items-start gap-3 ml-2 lg:ml-4 lg:my-1">
            <span class="shrink-0 w-3 h-3 mt-[2.5px] lg:mt-1.25" style={`background-color: var(--accent-bgc);`}></span>
            <span>
              <strong>My current agency is still around, they're just not delivering, can you still help?</strong><br />
              Yes. Plenty of people we talk to are in exactly this position, nothing needs to have gone wrong for it to be
              worth a second opinion.
            </span>
          </li>
        </ul>
      </div>
    </Grid>
  </section>

  <ContactForm title="Let's talk about what's happening with your agency." caller={SitePage.AGENCY_HELP} />
</Layout>

<style is:global>
  /* Scoped to this page only via the unique .ah-accent-cta class — mirrors CTA.astro's
     accent-fill hover treatment without touching the shared component. */
  .ah-accent-cta:hover {
    background-color: var(--accent-bgc);
    color: var(--ah-accent-cta-hover-text, #fff);
  }
</style>

<script is:inline>
  ;(function () {
    function setAccentCtaHoverText() {
      var accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-bgc').trim()
      var match = accent.match(/(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/)
      if (!match) return
      var r = parseInt(match[1]) / 255
      var g = parseInt(match[2]) / 255
      var b = parseInt(match[3]) / 255
      // sRGB relative luminance
      r = r <= 0.03928 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4)
      g = g <= 0.03928 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4)
      b = b <= 0.03928 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4)
      var L = 0.2126 * r + 0.7152 * g + 0.0722 * b
      document.documentElement.style.setProperty('--ah-accent-cta-hover-text', L > 0.4 ? '#000' : '#fff')
    }
    setAccentCtaHoverText()
  })()
</script>
