---
import LetsTalk from '@components/home/LetsTalk.astro'
import Insight from '@components/insights/Insight.astro'
import InsightSignoff from '@components/insights/InsightSignoff.astro'
import Layout from '@layouts/Layout.astro'
import { getInsightNav } from '@data/insights'
import InsightNav from '@components/insights/InsightNav.astro'
import InsightList from '@components/insights/InsightList.astro'

const { previous, current, next } = getInsightNav('what-about-off-shoring')

const offshoreCapabilities = [
  'Time and ability to work with a team in a different timezone',
  'Understanding of cultural differences and communication styles',
  'Strong project management skills',
  'Ability to clearly define requirements and expectations'
]

const offshoreTips = [
  'Write your requirements in User Stories format and include acceptance criteria for each story. This will help ensure that everyone has a clear understanding of what needs to be built and how it will be tested.',
  'Ensure you have access to the source code from day one. Download a copy of the codebase if not each day, then each week at minimum.',
  'Have the off-shore team provide you with the technical documentation before starting the project. Have this reviewed by someone technical.',
  "You'll generally have better results if you have the design done locally and provide it to the off-shore team.",
  'Ensure you have a contract in place that includes clear deliverables, timelines, and payment terms.'
]
---

<Layout title={current?.title} description={current?.summary}>
  <Insight tags={current?.tags}>
    <span slot="insight-title">{current?.title}</span>
    <span slot="insight-subtitle">{current?.dateLabel}</span>
    <span slot="insight-text">
      <p>
        You're probably expecting us to say that off-shoring is a bad idea, you should never do it, it's scary, etc. And
        we should, as it is direct competition to our <a href="/services" class="underline underline-offset-2"
          >services</a
        >. But the truth is, off-shoring can be a good idea in some circumstances. That's why all the big four banks
        have been doing it for years. It's not inherently bad, it just has to be managed well.
      </p><br />
      <p>
        If you have the below skills/capabilities in-house, then off-shoring can be a good way to save money on
        development costs:
      </p>

      <InsightList items={offshoreCapabilities} />

      <br />
      <br />

      <p>
        If you think you have the above capabilities and are prepared to manage the risks, then here are some tips for
        you to help you succeed:
      </p>

      <InsightList items={offshoreTips} />

      <br />
      <br />

      <p>
        If you don't have those capabilities, or you need help managing the risks, then we can help <a
          href="/services/consulting"
          class="underline underline-offset-2">consult</a
        > so that you are in a better position to succeed. Check out the <a
          href="/case-studies/cyprusays"
          class="underline underline-offset-2">Cyprusays case study</a
        > for an example of how we helped a client successfully manage a third-party vendor relationship.
      </p><br />
      <InsightSignoff />
    </span>
  </Insight>
  <InsightNav previousInsight={previous} nextInsight={next} />

  <LetsTalk config={{ buttons: 'both', primaryCta: 'message' }} />
</Layout>
