---
import Grid from '@components/Grid.astro'
import Layout from '@layouts/Layout.astro'
import PageHeading from '@components/case-studies/PageHeading.astro'
import InsightCard from '@components/insights/InsightCard.astro'
import Callout from '@components/case-studies/CallOut.astro'
import { publishedInsights } from '@data/insights'
import { resolvePixelColour } from '@config/colours'
import Plus from '@components/signs/Plus.astro'

const insightItems = publishedInsights.map((insight) => ({
  title: insight.title,
  summary: insight.summary,
  dateLabel: insight.dateLabel,
  publishedAt: insight.publishedAt,
  tags: insight.tags,
  href: `/insights/${insight.slug}`,
  backgroundColor: resolvePixelColour(insight.colour)
}))

const allTags = [...new Set(publishedInsights.flatMap((insight) => insight.tags))].sort()

function monthLabel(publishedAt: string): string {
  const date = new Date(`${publishedAt}T00:00:00`)
  const month = date.toLocaleString('en-US', { month: 'long' })
  return `${month}, ${date.getFullYear()}`
}

const monthGroups: { key: string; label: string; insights: typeof insightItems }[] = []
for (const insight of insightItems) {
  const key = insight.publishedAt.slice(0, 7)
  let group = monthGroups.find((g) => g.key === key)
  if (!group) {
    group = { key, label: monthLabel(insight.publishedAt), insights: [] }
    monthGroups.push(group)
  }
  group.insights.push(insight)
}
---

<Layout title="Insights" description="A collection of insights on various topics related to project development.">
  <Grid>
    <PageHeading>
      <span slot="heading-title">Insights</span>
      <span slot="heading-text"
        >A collection of insights on various topics related to project discovery, design, development <Plus
          size={24}
          desktopSize={34}
        /> management.</span
      >
    </PageHeading>

    {/* tag filters */}
    <div id="tag-filters" class="col-span-full lg:col-start-2 lg:col-span-10 flex flex-wrap justify-end gap-3 mb-2">
      {
        allTags.map((tag) => (
          <label class="tag-filter cursor-pointer hover:underline hover:underline-offset-2 font-sans font-normal inline-block bg-white px-4 py-2 text-[18px] transition-colors select-none">
            <input type="checkbox" value={tag} class="tag-checkbox sr-only" />
            {tag}
          </label>
        ))
      }
    </div>

    <div class="col-span-full lg:col-start-2 lg:col-span-10 flex justify-end -mt-2">
      <button
        id="clear-tag-filters"
        type="button"
        class="font-sans text-[18px] underline underline-offset-2 hover:opacity-70 transition-opacity hover:cursor-pointer"
        >clear</button
      >
    </div>

    <div class="col-span-full lg:col-start-2 lg:col-span-10 flex flex-col gap-12 lg:gap-20 mt-6 pb-12 lg:pb-20">
      {
        monthGroups.map((group) => (
          <div class="month-section" data-month={group.key}>
            <h2 class="text-xl lg:text-3xl font-light mb-4">Insights for {group.label}</h2>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
              {group.insights.map((insight) => (
                <div class="insight-grid-item" data-tags={JSON.stringify(insight.tags)}>
                  <InsightCard
                    title={insight.title}
                    summary={insight.summary}
                    dateLabel={insight.dateLabel}
                    href={insight.href}
                    backgroundColor={insight.backgroundColor}
                    tags={insight.tags}
                  />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Grid>

  <Callout text="See something that sparked your interest? We are happy to talk." ctaLabel="Send a message →" />

  <style>
    .tag-filter:hover,
    .tag-filter.active {
      background-color: #cac0b8;
      color: #fff;
    }
  </style>

  <script>
    function initTagFilters() {
      const checkboxes = document.querySelectorAll<HTMLInputElement>('.tag-checkbox')
      const items = document.querySelectorAll<HTMLElement>('.insight-grid-item')
      const monthSections = document.querySelectorAll<HTMLElement>('.month-section')

      function applyFilters() {
        const selected = Array.from(checkboxes)
          .filter((cb) => cb.checked)
          .map((cb) => cb.value)

        checkboxes.forEach((cb) => {
          const label = cb.closest('.tag-filter')
          if (label) {
            label.classList.toggle('active', cb.checked)
          }
        })

        items.forEach((item) => {
          const tags: string[] = JSON.parse(item.dataset.tags || '[]')
          const match = selected.length === 0 || selected.some((s) => tags.includes(s))
          item.style.display = match ? '' : 'none'
        })

        monthSections.forEach((section) => {
          const sectionItems = section.querySelectorAll<HTMLElement>('.insight-grid-item')
          const anyVisible = Array.from(sectionItems).some((item) => item.style.display !== 'none')
          section.style.display = anyVisible ? '' : 'none'
        })
      }

      checkboxes.forEach((cb) => cb.addEventListener('change', applyFilters))

      const clearBtn = document.querySelector<HTMLButtonElement>('#clear-tag-filters')
      clearBtn?.addEventListener('click', () => {
        checkboxes.forEach((cb) => {
          cb.checked = false
        })
        applyFilters()
      })
    }

    initTagFilters()
    document.addEventListener('astro:after-swap', initTagFilters)
  </script>
</Layout>
