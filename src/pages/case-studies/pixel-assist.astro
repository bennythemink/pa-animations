---
import ContactForm from '@components/ContactForm.astro'
import { SitePage } from '@data/analyticsCaller'
import Grid from '@components/Grid.astro'
import Layout from '@layouts/Layout.astro'
import CaseStudySectionText from '@components/case-studies/case-study/CaseStudySectionText.astro'
import CaseStudyResults from '@components/case-studies/case-study/CaseStudyResults.astro'
import CaseStudyHeader from '@components/case-studies/case-study/CaseStudyHeader.astro'
import CaseStudyToggleButton from '@components/case-studies/case-study/CaseStudyToggleButton.astro'
import CaseStudyMetaData from '@components/case-studies/case-study/CaseStudyMetaData.astro'
import CaseStudyShout from '@components/case-studies/case-study/CaseStudyShout.astro'
import CaseStudyNav from '@components/case-studies/case-study/CaseStudyNav.astro'
import CaseStudyImages from '@components/case-studies/case-study/CaseStudyImages.astro'
import { getCaseStudyNav } from '@data/caseStudies'

import hero from '@assets/case-studies/pixel-assist/hero.webp'
import squareOne from '@assets/case-studies/pixel-assist/squareOne.svg'
import squareTwo from '@assets/case-studies/pixel-assist/squareTwo.svg'
import wideOne from '@assets/case-studies/pixel-assist/wideOne.webp'
import wideTwo from '@assets/case-studies/pixel-assist/wideTwo.webp'

const { previous, next } = getCaseStudyNav('pixel-assist')
---

<Layout
  title="Pixel Assist Case Study"
  description="AI and consulting for a Pixel Agency client who is an Australian leader in their industry. Pixel Agency deployed Pixel Assist, an AI knowledge assistant on their website, helping users surface product information instantly and reducing customer support queries during a successful 2% feature-flagged trial."
>
  <article id="case-study-page">
    <CaseStudyHeader>
      <span slot="title">Pixel Assist</span>
      <span slot="industry">Manufacturing</span>
      <span slot="services">Pixel Assist</span>
      <span slot="duration">1 month</span>
    </CaseStudyHeader>

    <CaseStudyToggleButton />

    <!-- Single shell: all images + summary (left pane) / all case study text (right pane) -->
    <section class="pb-12 lg:pb-18">
      <Grid>
        <div id="case-study-shell" class="case-study-shell col-span-full">
          <div class="case-study-left-pane min-w-0 overflow-hidden">
            <CaseStudyImages
              heroImage={{ src: hero }}
              summary="How Pixel Agency are deploying Pixel Assist, an AI knowledge assistant, on a client's website to surface product knowledge in real time for their customers, with a rollout that proved the system out on a subset of users before scaling."
              squareImages={[{ src: squareOne }, { src: squareTwo }]}
              wideImages={[{ src: wideOne }, { src: wideTwo }]}
            />
          </div>

          <div class="case-study-right-pane min-w-0">
            <CaseStudyShout>
              An AI knowledge assistant for a Pixel Agency client, rolling out the careful way.
            </CaseStudyShout>

            <CaseStudySectionText title="The client" noTopMargin={true}>
              <p>
                The client is a category leader in the Australian manufacturing industry, with a long history of
                market-leading products and a deep well of technical knowledge to support them. They have an ongoing
                partnership with Pixel Agency across discovery, design, and development work, and are always looking for
                ways to use technology to make their customers' lives easier.
              </p><br />
              <p>
                The client has a large and diverse audience. They come to the client's website to find technical
                information that helps them make decisions about which products to use for specific applications. The
                client is committed to providing that information, but the depth and breadth of it can make it hard for
                users to find what they need quickly.
              </p><br />
              <p>
                We're not naming the client here because they see Pixel Assist as a genuine differentiator from their
                competition. They're planning to surprise the market with this release in the new financial year, and
                want to maintain that competitive advantage until launch.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The problem">
              <p>
                The depth of information on the client's website is part of why their customers come to it. It's also
                part of what gets in their way. Users trying to find the right product for a specific application have
                to hunt across HTML pages, PDF documents, and images to piece an answer together.
              </p><br />
              <p>
                Slow answers cost the client in two ways: support requests pile up where users can't self-serve, and a
                buyer who can't quickly find the right product is more likely to drift to a competitor whose information
                is easier to surface. With product specifications increasingly driven by performance, compliance, and
                time pressure, frictionless decision-making isn't a nice-to-have.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The approach">
              <p>
                We brought Pixel Assist to the client as a new addition to the ongoing partnership. Pixel Assist is our
                managed AI knowledge assistant: a RAG-based system that learns from a client's existing knowledge, with
                no fine-tuning required, and answers user questions in real time in the client's tone of voice. We
                started with discovery, working with the client to map the knowledge that would feed the system, the
                kinds of questions users actually need answered (product fit, install methods, application suitability),
                and the brand voice the assistant would need to use so every answer felt unmistakably the client's.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The solution">
              <p>
                Pixel Assist was deployed on the client's website with a familiar chat interface, but the deployment
                itself was where the care went in. Rather than turn the assistant on for every visitor at once, we used
                feature flagging to expose Pixel Assist to just 2% of users. That gave us a controlled environment to
                validate the system in the wild without putting the wider user base at risk if anything needed
                adjusting. The assistant answers user questions in real time, suggests the client's products that fit
                specific needs, and is built to support the various customer types in real time, helping them find what
                they need quickly.
              </p>
            </CaseStudySectionText>

            <CaseStudySectionText title="The results">
              <p>The 2% trial validated what the system could do on the three dimensions the client cared about:</p>
              <CaseStudyResults
                results={[
                  {
                    title: 'A measured fall ',
                    description: 'in customer support requests from users who reached the assistant',
                    backgroundColour: 'pixel-solar'
                  },
                  {
                    title: 'Questions answered to a high quality',
                    description: "with the client's tone of voice preserved across responses",
                    backgroundColour: 'pixel-celestial'
                  },
                  {
                    title: 'No incidents',
                    description:
                      'on the wider user base during the test period, thanks to the feature-flagged exposure',
                    backgroundColour: 'pixel-rosy'
                  },
                  {
                    title: 'A proven system',
                    description: 'ready to scale, with confidence on both quality and brand fit',
                    backgroundColour: 'pixel-teal'
                  }
                ]}
              />

              <div class="mt-6 lg:mt-12"></div>

              <CaseStudyShout>
                AI doesn't have to be all or nothing. The smart way in is the careful way.
              </CaseStudyShout>
            </CaseStudySectionText>

            <CaseStudyMetaData
              client={{ name: 'Redacted Client', url: 'https://www.pixelagency.com.au' }}
              industry={['Manufacturing']}
              serviceNames={['Pixel Assist']}
            />
          </div>
        </div>
      </Grid>
    </section>

    {/* Navigation section */}
    <CaseStudyNav previousCaseStudy={previous} nextCaseStudy={next} />

    <ContactForm
      title="Discuss a similar challenge"
      displayDescription={false}
      caller={SitePage.CASE_STUDIES_PIXEL_ASSIST}
    />
  </article>

  <style>
    #case-study-page {
      --case-study-border: color-mix(in oklab, var(--color-black) 8%, transparent);
      --case-study-placeholder: var(--color-pixel-placeholder-grey);
    }

    @media (max-width: 1023px) {
      .case-study-shell {
        display: flex;
        gap: 0;
        overflow: clip;
      }

      .case-study-left-pane {
        flex: 0 0 auto;
        width: 100%;
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 240ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      #case-study-page[data-panel-state='open'] .case-study-left-pane {
        width: 0;
        max-height: 0;
        opacity: 0;
        transform: translateX(-2rem);
        pointer-events: none;
      }

      .case-study-right-pane {
        flex: 0 0 auto;
        width: 0;
        max-height: 0;
        opacity: 0;
        overflow: clip;
        transform: translateX(2rem);
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 260ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      #case-study-page[data-panel-state='open'] .case-study-right-pane {
        width: 100%;
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
    }

    @media (min-width: 1024px) {
      .case-study-shell {
        display: flex;
        gap: 0;
        transition: gap 420ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #case-study-page[data-panel-state='open'] .case-study-shell {
        gap: 1.25rem;
      }

      .case-study-left-pane,
      .case-study-right-pane {
        flex: 0 0 auto;
        transition:
          width 420ms cubic-bezier(0.22, 1, 0.36, 1),
          max-height 420ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 260ms ease,
          transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: width, max-height, opacity, transform;
      }

      .case-study-left-pane {
        width: 100%;
        max-height: 5000px;
      }

      .case-study-right-pane {
        width: 0;
        max-height: 0;
        opacity: 0;
        transform: translateX(2rem);
        overflow: clip;
        pointer-events: none;
      }

      #case-study-page[data-panel-state='open'] .case-study-left-pane {
        width: calc(50% - 0.625rem);
      }

      #case-study-page[data-panel-state='open'] .case-study-right-pane {
        width: calc(50% - 0.625rem);
        max-height: 5000px;
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .case-study-shell,
      .case-study-left-pane,
      .case-study-right-pane {
        transition: none;
      }
    }
  </style>

  <script>
    function initCaseStudyPage() {
      const page = document.getElementById('case-study-page')
      const toggle = document.getElementById('case-study-toggle')
      if (!(page instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return
      const pageElement = page
      const toggleButton = toggle

      const mobileMedia = window.matchMedia('(max-width: 1023px)')

      function setToggleTextColor() {
        const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-bgc').trim()
        const match = accent.match(/(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/)
        if (!match) return

        let red = parseInt(match[1], 10) / 255
        let green = parseInt(match[2], 10) / 255
        let blue = parseInt(match[3], 10) / 255

        red = red <= 0.03928 ? red / 12.92 : Math.pow((red + 0.055) / 1.055, 2.4)
        green = green <= 0.03928 ? green / 12.92 : Math.pow((green + 0.055) / 1.055, 2.4)
        blue = blue <= 0.03928 ? blue / 12.92 : Math.pow((blue + 0.055) / 1.055, 2.4)

        const luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue
        document.documentElement.style.setProperty('--case-study-toggle-text', luminance > 0.4 ? '#000' : '#fff')
      }

      function getDefaultState() {
        return 'closed'
      }

      if (!pageElement.dataset.panelState) {
        pageElement.dataset.panelState = getDefaultState()
      }

      function syncA11y() {
        const isOpen = pageElement.dataset.panelState === 'open'
        toggleButton.setAttribute('aria-expanded', String(isOpen))
      }

      setToggleTextColor()
      syncA11y()

      toggleButton.addEventListener('click', () => {
        pageElement.dataset.panelState = pageElement.dataset.panelState === 'open' ? 'closed' : 'open'
        syncA11y()
      })
    }

    initCaseStudyPage()
    document.addEventListener('astro:after-swap', initCaseStudyPage)
  </script>
</Layout>
